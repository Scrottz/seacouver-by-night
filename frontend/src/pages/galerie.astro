
---
import Layout from '../layouts/Layout.astro';
import data from '../../../data/db.json';

const pcs = data.characters.filter(c => c.type === 'PC');
const npcs = data.characters.filter(c => c.type === 'NPC');
const allImages = import.meta.glob('/public/res/img/**/*.{jpg,jpeg,png,webp}');

const getGallery = (char) => {
    const pattern = `/public/res/img/${char.type.toLowerCase()}/${char.slug}_`;
    return Object.keys(allImages).filter(p => p.startsWith(pattern)).sort().map(p => p.replace('/public', ''));
};

const groupedNpcs = npcs.reduce((acc, npc) => {
    const clan = npc.clan || "Unbekannt";
    if (!acc[clan]) acc[clan] = [];
    acc[clan].push({ ...npc, gallery: getGallery(npc) });
    return acc;
}, {} as Record<string, any[]>);

const sortedClans = Object.keys(groupedNpcs).sort();
const pcsWithGallery = pcs.map(pc => ({ ...pc, gallery: getGallery(pc) }));
---

<Layout title="Galerie | Seacouver">
    <h1 class="text-5xl font-bold mb-16 text-red-700 uppercase tracking-widest">Character Galerie</h1>

    <section class="mb-20">
        <h2 class="text-3xl font-bold mb-10 border-b border-gray-700 pb-4">Player Characters</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8">
            {pcsWithGallery.map(pc => (
                <div data-character={encodeURIComponent(JSON.stringify(pc))} class="bg-gray-900 border border-gray-800 p-5 rounded-lg hover:border-red-500 transition-all cursor-pointer">
                    <div class="relative w-full aspect-[2/3] overflow-hidden rounded-md">
                        <img src={pc.gallery[0] || '/placeholder.jpg'} alt={pc.name} class="absolute inset-0 w-full h-full object-cover object-top" />
                    </div>
                    <h3 class="text-center mt-5 text-lg font-bold">{pc.name}</h3>
                </div>
            ))}
        </div>
    </section>

    <section>
        <h2 class="text-3xl font-bold mb-12 border-b border-red-900 pb-4">Non-Player Characters</h2>
        {sortedClans.map(clan => (
            <div class="mb-16">
                <h3 class="text-xl font-semibold text-red-800 mb-8 uppercase tracking-widest">{clan}</h3>
                <div class="grid grid-cols-3 md:grid-cols-6 lg:grid-cols-8 gap-6">
                    {groupedNpcs[clan].map(npc => (
                        <div data-character={encodeURIComponent(JSON.stringify(npc))} class="bg-gray-900 border border-gray-800 p-4 rounded-lg hover:border-red-800 transition-all cursor-pointer">
                            <div class="relative w-full aspect-[2/3] overflow-hidden rounded-md">
                                <img src={npc.gallery[0] || '/placeholder.jpg'} alt={npc.name} class="absolute inset-0 w-full h-full object-cover object-top" />
                            </div>
                            <h3 class="text-center mt-4 text-base font-bold">{npc.name}</h3>
                        </div>
                    ))}
                </div>
            </div>
        ))}
    </section>
</Layout>
